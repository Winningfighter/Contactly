<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Contactly.Views.FaqPage">

    <Grid RowDefinitions="Auto, *" Padding="20">

        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,0,0,20">
            <Button Text="Zurück" 
                    Clicked="OnBackClicked"
                    HeightRequest="35"
                    Padding="10,0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryButton}, Dark={StaticResource SecondaryButtonDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource Font}, Dark={StaticResource FontSecondary}}"/>
            
            <Label Grid.Column="1" 
                   Text="Häufige Fragen" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Font}, Dark={StaticResource FontSecondary}}"/>
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding FaqItems}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                            Padding="0"
                            Margin="0,0,0,10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SurfaceDark}}">
                        
                        <VerticalStackLayout>
                            
                            <Grid ColumnDefinitions="*, Auto" Padding="15" BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuestionTapped" CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>

                                <Label Text="{Binding Question}" 
                                       FontAttributes="Bold" 
                                       FontSize="16"
                                       TextColor="{AppThemeBinding Light={StaticResource Font}, Dark={StaticResource FontSecondary}}"
                                       VerticalOptions="Center"/>

                                <Label Grid.Column="1" 
                                       Text="▼" 
                                       FontSize="12"
                                       Rotation="{Binding Rotation}"
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                       VerticalOptions="Center"/>
                            </Grid>

                            <VerticalStackLayout IsVisible="{Binding IsVisible}" Padding="15,0,15,15">
                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" Margin="0,0,0,10"/>
                                <Label Text="{Binding Answer}" 
                                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                            
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>