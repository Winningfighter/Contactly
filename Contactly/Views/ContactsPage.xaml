<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Contactly.Views.ContactsPage"
             xmlns:models="clr-namespace:Contactly.Models"
             Title="ContactsPage">
    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20">
            <Label Text="Kontakte" FontSize="32" FontAttributes="Bold" TextColor="{StaticResource Font}" VerticalOptions="Center"/>
            <HorizontalStackLayout Grid.Column="1" Spacing="10">
                <Button x:Name="BtnGrid" 
                        Text="Raster" 
                        Clicked="OnGridClicked"
                        BackgroundColor="{StaticResource PrimaryButtonActive}"
                        TextColor="White"/>

                <Button x:Name="BtnList" 
                        Text="Liste" 
                        Clicked="OnListClicked"
                        BackgroundColor="{StaticResource SecondaryButton}"
                        TextColor="{StaticResource Font}"/>
            </HorizontalStackLayout>
        </Grid>

        <CollectionView x:Name="ContactsCollection"
                        Grid.Row="1"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged"
                        Margin="20">

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Contact">
                    <Border StrokeShape="RoundRectangle 8"
                            Stroke="#E0E0E0"
                            Padding="15"
                            Margin="5"
                            BackgroundColor="White">

                        <Grid RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="Auto, *">

                            <Frame Grid.Row="0" Grid.RowSpan="3"
                                   CornerRadius="25" 
                                   HeightRequest="50" 
                                   WidthRequest="50" 
                                   BackgroundColor="{StaticResource Accent}" 
                                   Padding="0"
                                   VerticalOptions="Start">
                                <Label Text="{Binding Initials}" 
                                       TextColor="White" 
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center" 
                                       VerticalOptions="Center"/>
                            </Frame>

                            <VerticalStackLayout Grid.Column="1" Margin="15,0,0,0" Spacing="2">
                                <Label Text="{Binding FullName}" FontAttributes="Bold" TextColor="{StaticResource Font}" FontSize="16"/>
                                <Label Text="{Binding Email}" TextColor="Gray" FontSize="12"/>
                                <Label Text="{Binding Phone}" TextColor="Gray" FontSize="12"/>
                                <Label Text="{Binding Company}" TextColor="Gray" FontSize="12"/>
                            </VerticalStackLayout>

                            <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*, Auto" Margin="15,15,0,0">

                                <Button Text="Bearbeiten" 
                                        Clicked="OnEditClicked"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="{StaticResource SecondaryButton}" 
                                        TextColor="{StaticResource Font}"
                                        HeightRequest="35"
                                        Padding="10,0"
                                        FontSize="12"/>

                                <ImageButton Source="delete_icon.png" 
                                             Clicked="OnDeleteClicked"
                                             CommandParameter="{Binding .}"
                                             BackgroundColor="{StaticResource Issue}" 
                                             CornerRadius="5"
                                             Padding="8"
                                             Grid.Column="1" 
                                             WidthRequest="35"
                                             HeightRequest="35"
                                             Margin="10,0,0,0"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
    </Grid>
</ContentPage>