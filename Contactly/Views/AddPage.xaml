<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Contactly.Views.AddPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="AddPage">
    <Grid RowDefinitions="Auto, *">
        <Grid Padding="20" BackgroundColor="Transparent" ColumnDefinitions="*, Auto, Auto">
            <Label FontAttributes="Bold" FontSize="32" Text="Hinzufügen" />
            <Button
                Grid.Column="1"
                Margin="0,0,10,0"
                Style="{StaticResource SecondaryButtonStyle}"
                Text="Abbrechen" />
            <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Text="Hinzufügen" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="40,0,40,20"
                HorizontalOptions="Start"
                WidthRequest="800"
                Spacing="15">

                <VerticalStackLayout>
                    <Label FontAttributes="Bold" Text="Vorname" />
                    <Entry BackgroundColor="#EEEEEE" Placeholder="" TextColor="{StaticResource Font}" WidthRequest="300"/>
                    <Label x:Name="ErrVorname" FontSize="14" IsVisible="False" Text="Dieses Feld darf nicht leer sein!" TextColor="{StaticResource Attention}" />
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Label FontAttributes="Bold" Text="Nachname" />
                    <Entry BackgroundColor="#EEEEEE" Placeholder="" TextColor="{StaticResource Font}" />
                    <Label x:Name="ErrNachname" FontSize="14" IsVisible="False" Text="Dieses Feld darf nicht leer sein!" TextColor="{StaticResource Attention}" />
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Label Text="Notizen" FontAttributes="Bold"/>
                    <Editor HeightRequest="150" BackgroundColor="#EEEEEE" AutoSize="TextChanges"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>